<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <Nullable>enable</Nullable>
    <!-- Build paths. Override with environment variables (see build.ps1 / BUILD.md).
         Standard install: ValheimInstallDir = game folder (contains valheim_Data AND BepInEx).
         r2modman: ValheimInstallDir = Steam game folder, BepInExDir = profile folder. -->
    <ValheimInstallDir Condition="'$(ValheimInstallDir)' == ''">/home/archipelago/Steam/valheim</ValheimInstallDir>
    <BepInExDir Condition="'$(BepInExDir)' == ''">$(ValheimInstallDir)</BepInExDir>
    <JotunnDll Condition="'$(JotunnDll)' == ''">$(BepInExDir)/BepInEx/plugins/Jotunn.dll</JotunnDll>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Archipelago.MultiClient.Net" Version="6.7.1" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="0Harmony">
      <HintPath>$(BepInExDir)/BepInEx/core/0Harmony.dll</HintPath>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(ValheimInstallDir)/valheim_Data/Managed/Assembly-CSharp.dll</HintPath>
    </Reference>
    <Reference Include="assembly_guiutils">
      <HintPath>$(ValheimInstallDir)/valheim_Data/Managed/assembly_guiutils.dll</HintPath>
    </Reference>
    <Reference Include="assembly_utils">
      <HintPath>$(ValheimInstallDir)/valheim_Data/Managed/assembly_utils.dll</HintPath>
    </Reference>
    <Reference Include="assembly_valheim">
      <HintPath>$(ValheimInstallDir)/valheim_Data/Managed/assembly_valheim.dll</HintPath>
    </Reference>
    <Reference Include="BepInEx">
      <HintPath>$(BepInExDir)/BepInEx/core/BepInEx.dll</HintPath>
    </Reference>
    <Reference Include="BepInEx.Harmony">
      <HintPath>$(BepInExDir)/BepInEx/core/BepInEx.Harmony.dll</HintPath>
    </Reference>
    <Reference Include="BepInEx.Preloader">
      <HintPath>$(BepInExDir)/BepInEx/core/BepInEx.Preloader.dll</HintPath>
    </Reference>
    <Reference Include="Jotunn">
      <HintPath>$(JotunnDll)</HintPath>
    </Reference>
    <Reference Include="Unity.InputSystem">
      <HintPath>$(ValheimInstallDir)/valheim_Data/Managed/Unity.InputSystem.dll</HintPath>
    </Reference>
    <Reference Include="Unity.InputSystem.ForUI">
      <HintPath>$(ValheimInstallDir)/valheim_Data/Managed/Unity.InputSystem.ForUI.dll</HintPath>
    </Reference>
    <Reference Include="Unity.TextMeshPro">
      <HintPath>$(ValheimInstallDir)/valheim_Data/Managed/Unity.TextMeshPro.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(ValheimInstallDir)/valheim_Data/Managed/UnityEngine.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.AssetBundleModule">
      <HintPath>$(ValheimInstallDir)/valheim_Data/Managed/UnityEngine.AssetBundleModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ValheimInstallDir)/valheim_Data/Managed/UnityEngine.CoreModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(ValheimInstallDir)/valheim_Data/Managed/UnityEngine.IMGUIModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.InputForUIModule">
      <HintPath>$(ValheimInstallDir)/valheim_Data/Managed/UnityEngine.InputForUIModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(ValheimInstallDir)/valheim_Data/Managed/UnityEngine.InputLegacyModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.InputModule">
      <HintPath>$(ValheimInstallDir)/valheim_Data/Managed/UnityEngine.InputLegacyModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(ValheimInstallDir)/valheim_Data/Managed/UnityEngine.UI.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.UIElementsModule">
      <HintPath>$(ValheimInstallDir)/valheim_Data/Managed/UnityEngine.UIElementsModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(ValheimInstallDir)/valheim_Data/Managed/UnityEngine.UIModule.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>
